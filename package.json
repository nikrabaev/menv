{
  "name": "menv",
  "version": "2.0.0",
  "private": true,
  "description": "Keyboard-friendly CLI + TUI for managing environment variables across a monorepo, with age-encrypted vaults and generated .env files.",
  "type": "module",
  "license": "MIT",
  "author": "Nikita Rabaev",
  "homepage": "https://github.com/nikrabaev/menv#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/nikrabaev/menv.git"
  },
  "bugs": {
    "url": "https://github.com/nikrabaev/menv/issues"
  },
  "keywords": [
    "env",
    "environment-variables",
    "dotenv",
    "secrets",
    "vault",
    "age-encryption",
    "monorepo",
    "cli",
    "tui"
  ],
  "bin": {
    "menv": "./src/index.ts"
  },
  "scripts": {
    "menv": "bun run src/index.ts",
    "build": "bun build --compile --outfile menv src/index.ts",
    "build:npm": "bun run npm/build-npm.ts",
    "test": "bun test",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "demo:gif": "bash scripts/capture-tui-demo.sh"
  },
  "dependencies": {
    "@commander-js/extra-typings": "^15",
    "@inkjs/ui": "^2.0.0",
    "age-encryption": "^0.3.0",
    "commander": "^15",
    "ink": "^7.0.5",
    "react": "^19.2.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.16",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.17",
    "ink-testing-library": "^4.0.0"
  }
}
